[Unit]
Description=atlas
Documentation=https://atlas.arwos.org/
After=network.target

[Service]
Type=simple

User=atlas
Group=atlas

Restart=on-failure
RestartSec=30s
ExecStart=/usr/bin/atlas --config=/etc/atlas/config.yaml
KillMode=process
KillSignal=SIGTERM
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=default.target
